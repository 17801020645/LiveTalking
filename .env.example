# 首次启动且用户表为空时创建管理员（不要提交真实密码）
# LIVETALKING_BOOTSTRAP_ADMIN=admin
# LIVETALKING_BOOTSTRAP_PASSWORD=change-me
# LIVETALKING_PLATFORM_DB=data/platform.db

# CORS 额外 Origin（逗号分隔）。当前访问 Host 对应源始终放行。
# LIVETALKING_CORS_ORIGINS=http://localhost:5173

# 管理员 TTS 代理上游，默认 http://127.0.0.1:8091
# LIVETALKING_TTS_UPSTREAM=http://127.0.0.1:8091

TENCENT_APPID=xxxxxxxx
TENCENT_SECRET_KEY=xxxxxxxx
TENCENT_SECRET_ID=xxxxxxxx
DASHSCOPE_API_KEY=xxxxxxxx
DOUBAO_API_KEY=xxxxxxxx

# Chat 模式 LLM（OpenAI 兼容）。优先 LLM_API_KEY，其次 DASHSCOPE_API_KEY
# LLM_API_KEY=xxxxxxxx
# OPENAI_API_KEY=xxxxxxxx