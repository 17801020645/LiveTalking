# NEXUS 生产环境示例；复制为 .env 并填入真实密钥，不要提交。
PROD=1
NEXUS_COOKIE_SECURE=1
# 在 Caddy/Nginx 后面时设为 1；直连 8010 时保持 0
TRUST_PROXY=0
PROD_HSTS=0
LOGIN_MAX_FAILS=5
LOGIN_WINDOW_SECONDS=300
LOGIN_BLOCK_SECONDS=300
BACKUP_RETENTION_DAYS=7

# 外部服务密钥（按需）
DEEPSEEK_API_KEY=
DASHSCOPE_API_KEY=
DOUBAO_API_KEY=
TENCENT_APPID=
TENCENT_SECRET_ID=
TENCENT_SECRET_KEY=

# 可选：首次初始化管理员；已有用户时不会覆盖
LIVETALKING_BOOTSTRAP_ADMIN=
LIVETALKING_BOOTSTRAP_PASSWORD=
